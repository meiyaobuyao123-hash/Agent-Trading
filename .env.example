# ===== SUPABASE =====
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ===== UPSTASH REDIS =====
UPSTASH_REDIS_REST_URL=https://your-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-token

# ===== OKX DEX API (server-side only, never expose to client) =====
OKX_API_KEY=your-okx-api-key
OKX_SECRET_KEY=your-okx-secret-key
OKX_PASSPHRASE=your-okx-passphrase

# ===== APP =====
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ===== SIGNAL ENGINE =====
# 保护 /api/engine/sync-signals 不被未授权调用（Vercel Cron + 手动触发共用）
CRON_SECRET=your-random-secret-here
# Admin 后台调用 Web 的引擎接口（不同端口/域名时设置）
NEXT_PUBLIC_WEB_BASE_URL=http://localhost:3000

# ===== AI (Claude API for strategy generation) =====
ANTHROPIC_API_KEY=your-claude-api-key

# ===== OKX DEX EXECUTION ENGINE (热钱包，仅服务端) =====
# 配置后启用真实 DEX 执行，否则运行干跑（dry-run）模式
# ⚠️ 极度敏感！生产环境使用 Secret Manager，不要写入代码
SERVER_WALLET_PRIVATE_KEY=0xyour-hot-wallet-private-key
SERVER_WALLET_ADDRESS=0xyour-hot-wallet-address
# 链 RPC（可选，有默认公共节点，生产环境建议用私有 RPC）
CHAIN_RPC_56=https://bsc-dataseed1.binance.org
CHAIN_RPC_1=https://eth.llamarpc.com
