{
  "tool": "calc_risk_metrics",
  "version": "v1.0",
  "owner": "agent-team",
  "cases": [
    {
      "name": "empty_trades_returns_zero",
      "description": "空 trades 返 trade_count=0,不抛错",
      "input": {"trades": []},
      "expected_outcome": "ok_with_check",
      "expect_fields": {"trade_count": 0, "win_rate": 0.0}
    },
    {
      "name": "all_wins_metric",
      "input": {"trades": [
        {"is_closed": true, "pnl_ratio": 1.5, "d3_pct": 50},
        {"is_closed": true, "pnl_ratio": 1.3, "d3_pct": 30},
        {"is_closed": true, "pnl_ratio": 1.4, "d3_pct": 40}
      ]},
      "expected_outcome": "ok_with_check",
      "expect_fields": {"win_rate": 1.0, "trade_count": 3}
    },
    {
      "name": "mixed_50_50",
      "input": {"trades": [
        {"is_closed": true, "pnl_ratio": 1.2},
        {"is_closed": true, "pnl_ratio": 0.8},
        {"is_closed": true, "pnl_ratio": 1.3},
        {"is_closed": true, "pnl_ratio": 0.7}
      ]},
      "expected_outcome": "ok_with_check",
      "expect_fields": {"win_rate": 0.5, "trade_count": 4}
    },
    {
      "name": "open_positions_use_d3",
      "input": {"trades": [
        {"is_closed": false, "d3_pct": 25},
        {"is_closed": false, "d3_pct": 30},
        {"is_closed": false, "d3_pct": 10}
      ]},
      "expected_outcome": "ok"
    },
    {
      "name": "all_losses_negative_ev",
      "input": {"trades": [
        {"is_closed": true, "pnl_ratio": 0.7},
        {"is_closed": true, "pnl_ratio": 0.6},
        {"is_closed": true, "pnl_ratio": 0.8}
      ]},
      "expected_outcome": "ok_with_check",
      "expect_fields": {"win_rate": 0.0}
    },
    {
      "name": "missing_trades_field_invalid",
      "input": {},
      "expected_outcome": "input_invalid"
    },
    {
      "name": "trades_wrong_type_invalid",
      "input": {"trades": "not a list"},
      "expected_outcome": "input_invalid"
    },
    {
      "name": "trade_missing_is_closed_invalid",
      "input": {"trades": [{"pnl_ratio": 1.2}]},
      "expected_outcome": "input_invalid"
    },
    {
      "name": "trade_pnl_ratio_string_invalid",
      "input": {"trades": [{"is_closed": true, "pnl_ratio": "high"}]},
      "expected_outcome": "input_invalid"
    },
    {
      "name": "single_trade_minimal",
      "input": {"trades": [{"is_closed": true, "pnl_ratio": 1.1}]},
      "expected_outcome": "ok"
    },
    {
      "name": "ten_winning_high_sharpe",
      "input": {"trades": [
        {"is_closed": true, "pnl_ratio": 1.1},
        {"is_closed": true, "pnl_ratio": 1.15},
        {"is_closed": true, "pnl_ratio": 1.12},
        {"is_closed": true, "pnl_ratio": 1.08},
        {"is_closed": true, "pnl_ratio": 1.13},
        {"is_closed": true, "pnl_ratio": 1.11},
        {"is_closed": true, "pnl_ratio": 1.14},
        {"is_closed": true, "pnl_ratio": 1.09},
        {"is_closed": true, "pnl_ratio": 1.10},
        {"is_closed": true, "pnl_ratio": 1.16}
      ]},
      "expected_outcome": "ok_with_check",
      "expect_fields": {"win_rate": 1.0, "trade_count": 10}
    }
  ]
}
