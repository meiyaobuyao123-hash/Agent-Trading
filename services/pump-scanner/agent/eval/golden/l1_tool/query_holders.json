{
  "tool": "query_holders",
  "version": "v1.0",
  "owner": "agent-team",
  "cases": [
    {
      "name": "missing_chain_invalid",
      "input": {"token_address": "0xabc"},
      "expected_outcome": "input_invalid"
    },
    {
      "name": "missing_token_address_invalid",
      "input": {"chain": "solana"},
      "expected_outcome": "input_invalid"
    },
    {
      "name": "token_address_empty_invalid",
      "input": {"chain": "solana", "token_address": ""},
      "expected_outcome": "input_invalid"
    },
    {
      "name": "unknown_chain_invalid",
      "input": {"chain": "polygon", "token_address": "0xabc"},
      "expected_outcome": "input_invalid"
    },
    {
      "name": "limit_too_large_invalid",
      "input": {"chain": "solana", "token_address": "0xabc", "limit": 100},
      "expected_outcome": "input_invalid"
    },
    {
      "name": "limit_zero_invalid",
      "input": {"chain": "solana", "token_address": "0xabc", "limit": 0},
      "expected_outcome": "input_invalid"
    },
    {
      "name": "valid_no_holders_returns_ok_false",
      "description": "无 Helius key 或 token 不存在 → fetch 返空 → ok=true,output.ok=false",
      "input": {"chain": "solana", "token_address": "Bonk1111fake"},
      "expected_outcome": "ok",
      "skip_idempotent_check": true
    },
    {
      "name": "valid_evm_chain_default",
      "input": {"chain": "eth", "token_address": "0xabcdef0123"},
      "expected_outcome": "ok",
      "skip_idempotent_check": true
    },
    {
      "name": "valid_with_explicit_limit",
      "input": {"chain": "bsc", "token_address": "0xabcdef0123", "limit": 5},
      "expected_outcome": "ok",
      "skip_idempotent_check": true
    },
    {
      "name": "valid_base_chain",
      "input": {"chain": "base", "token_address": "0xabcdef0123"},
      "expected_outcome": "ok",
      "skip_idempotent_check": true
    }
  ]
}
