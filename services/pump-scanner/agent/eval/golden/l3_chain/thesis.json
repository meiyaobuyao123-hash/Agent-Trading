  "cases": [
    {
      "name": "class_loadable",
      "chain_id": "thesis",
      "expected_outcome": "class_loadable"
    },
    {
      "name": "entry_method_generate",
      "description": "ThesisLoop.generate(device_id, chain, token, level) 是主入口",
